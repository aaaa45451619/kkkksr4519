local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = "FlyGUI"

local function createButton(text, pos)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0.12, 0, 0.08, 0)
	button.Position = pos
	button.Text = text
	button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextScaled = true
	button.Parent = screenGui
	return button
end

local flyButton = createButton("FLY", UDim2.new(0.05, 0, 0.75, 0))
local upButton = createButton("UP", UDim2.new(0.19, 0, 0.75, 0))
local downButton = createButton("DOWN", UDim2.new(0.33, 0, 0.75, 0))
local forwardButton = createButton("↑", UDim2.new(0.75, 0, 0.65, 0))
local backButton = createButton("↓", UDim2.new(0.75, 0, 0.85, 0))
local leftButton = createButton("←", UDim2.new(0.68, 0, 0.75, 0))
local rightButton = createButton("→", UDim2.new(0.82, 0, 0.75, 0))

local flying = false
local speed = 50
local direction = {
	up = false, down = false,
	forward = false, back = false,
	left = false, right = false
}

local function fly()
	RunService:BindToRenderStep("FlyMovement", Enum.RenderPriority.Character.Value, function()
		if flying and hrp then
			local cam = workspace.CurrentCamera
			local move = Vector3.zero

			if direction.up then move += Vector3.new(0, speed, 0) end
			if direction.down then move += Vector3.new(0, -speed, 0) end
			if direction.forward then move += cam.CFrame.LookVector * speed end
			if direction.back then move -= cam.CFrame.LookVector * speed end
			if direction.left then move -= cam.CFrame.RightVector * speed end
			if direction.right then move += cam.CFrame.RightVector * speed end

			hrp.Velocity = move
		end
	end)
end

flyButton.MouseButton1Click:Connect(function()
	flying = not flying
	flyButton.Text = flying and "STOP" or "FLY"
	if flying then
		fly()
	else
		RunService:UnbindFromRenderStep("FlyMovement")
		hrp.Velocity = Vector3.zero
	end
end)

-- ボタン操作用関数
local function bindButton(button, key)
	button.MouseButton1Down:Connect(function() direction[key] = true end)
	button.MouseButton1Up:Connect(function() direction[key] = false end)
end

bindButton(upButton, "up")
bindButton(downButton, "down")
bindButton(forwardButton, "forward")
bindButton(backButton, "back")
bindButton(leftButton, "left")
bindButton(rightButton, "right")
