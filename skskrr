local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = "FlyGUI"

local function createButton(text, pos, size)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = pos
	button.Text = text
	button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	button.TextColor3 = Color3.new(1,1,1)
	button.TextScaled = true
	button.Parent = screenGui
	return button
end

local flyButton = createButton("FLY", UDim2.new(0.05, 0, 0.8, 0), UDim2.new(0.15, 0, 0.08, 0))
local upButton = createButton("UP", UDim2.new(0.23, 0, 0.8, 0), UDim2.new(0.15, 0, 0.08, 0))
local downButton = createButton("DOWN", UDim2.new(0.41, 0, 0.8, 0), UDim2.new(0.15, 0, 0.08, 0))

local flying = false
local speed = 50
local up = false
local down = false

local function fly()
	RunService:BindToRenderStep("FlyMovement", Enum.RenderPriority.Character.Value, function()
		if flying and hrp then
			local move = Vector3.new(0, 0, 0)
			if up then move = move + Vector3.new(0, speed, 0) end
			if down then move = move - Vector3.new(0, speed, 0) end
			hrp.Velocity = move
		end
	end)
end

flyButton.MouseButton1Click:Connect(function()
	flying = not flying
	flyButton.Text = flying and "STOP" or "FLY"
	if flying then
		fly()
	else
		RunService:UnbindFromRenderStep("FlyMovement")
		hrp.Velocity = Vector3.zero
	end
end)

upButton.MouseButton1Down:Connect(function() up = true end)
upButton.MouseButton1Up:Connect(function() up = false end)

downButton.MouseButton1Down:Connect(function() down = true end)
downButton.MouseButton1Up:Connect(function() down = false end)
